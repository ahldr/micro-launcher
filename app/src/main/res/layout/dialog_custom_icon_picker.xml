<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/dialog_custom_icon_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@android:string/search_go"
        android:inputType="text"
        android:importantForAutofill="no" />

    <ProgressBar
        android:id="@+id/dialog_custom_icon_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:indeterminate="true" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialog_custom_icon_recycler"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/dialog_custom_icon_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_custom_icon_reset" />

</LinearLayout>
