<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_categories_row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/list_categories_row_handle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:alpha="0.6"
        android:contentDescription="@string/content_description_reorder_category"
        android:padding="12dp"
        android:src="@drawable/baseline_drag_handle_24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/list_categories_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="18sp"
            tools:text="Messaging" />

        <TextView
            android:id="@+id/list_categories_row_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.6"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp"
            tools:text="3 apps · Signal, Element, Delta Chat" />
    </LinearLayout>

    <ImageView
        android:id="@+id/list_categories_row_rename"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/content_description_rename_category"
        android:padding="12dp"
        android:src="@drawable/baseline_edit_24" />

    <ImageView
        android:id="@+id/list_categories_row_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/content_description_delete_category"
        android:padding="12dp"
        android:src="@drawable/baseline_delete_24" />

</LinearLayout>
