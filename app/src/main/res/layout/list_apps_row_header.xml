<?xml version="1.0" encoding="utf-8"?>
<!-- Heading of a category of favorite apps. Colors and insets are set by AppsRecyclerAdapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_apps_header_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="20dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/list_apps_header_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:textSize="13sp"
        tools:text="Messaging" />

    <View
        android:id="@+id/list_apps_header_rule"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:importantForAccessibility="no" />

</LinearLayout>
