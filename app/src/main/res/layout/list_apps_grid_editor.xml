<?xml version="1.0" encoding="utf-8"?>
<!-- Shown instead of the search bar while the grid is being customized, see GridEditor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/cardBackgroundColor"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <include
        android:id="@+id/grid_editor_columns"
        layout="@layout/grid_editor_slider" />

    <include
        android:id="@+id/grid_editor_icon_size"
        layout="@layout/grid_editor_slider" />

    <include
        android:id="@+id/grid_editor_label_size"
        layout="@layout/grid_editor_slider" />

    <include
        android:id="@+id/grid_editor_side_padding"
        layout="@layout/grid_editor_slider" />

    <include
        android:id="@+id/grid_editor_row_spacing"
        layout="@layout/grid_editor_slider" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/grid_editor_labels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:paddingEnd="8dp"
        android:text="@string/grid_editor_labels"
        android:textColor="?android:textColor"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/grid_editor_reset"
            style="@style/AlertDialogThemedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grid_editor_reset" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/grid_editor_cancel"
            style="@style/AlertDialogThemedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_cancel" />

        <Button
            android:id="@+id/grid_editor_save"
            style="@style/AlertDialogThemedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grid_editor_save" />
    </LinearLayout>

</LinearLayout>
